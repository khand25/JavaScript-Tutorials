// Logical AND (&&) and Logical OR (||)

// create two variables a and b boolean variables
let a = true;
let b = false;

function getName(name) {
    return name;
}

//returns true as both a and b evalute to true
console.log(a && getName('Danyal Khan'));

// if atleast one is true than the entire thing is true
// for or operations
console.log(a||b);

/**
 * Template literals (f Strings in JS)
 */

let name1 = "John";
let name2 = "Doe";

console.log(name1 + " "+ name2);

// Another way to accompshe same String as above
console.log(`${name1} ${name2}`);

/**
 * Ternary operator to use as if statements in  
 * react code
 */

let showRecipeOne = false;

function getRecipeOneName(recipeName) {
    return recipeName;
}

function getRecipeTwoName(recipeName) {
    return recipeName;

}

if(showRecipeOne) {
    console.log(getRecipeOneName('Pizza'));
} else {
    console.log(getRecipeTwoName('Coke'));
}

// Use ternary operator instead of if/else statment

// General format
// condition ? statement1: statement2;


// same if/else statement above translated to ternary operator
showRecipeOne ? console.log(getRecipeOneName('Pizza')) : console.log(getRecipeTwoName('Coke'));

